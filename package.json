{
  "name": "photo-screensaver",
  "version": "4.0.0",
  "private": true,
  "description": "Photo Screen Saver Chrome extension (Manifest V3 + Lit)",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node test/e2e/folders.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "puppeteer-core": "^24.43.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
